{
  "name": "costlight",
  "description": "Local, replay-safe metered API cost tracking for Kimi Code and Claude Code.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/app/development.ts",
    "start": "bun src/app/start.ts",
    "import": "bun src/app/import-history.ts",
    "analyze-cache": "bun src/cache-analysis/run.ts",
    "audit": "bun src/app/audit.ts",
    "audit:claude-usage": "bun src/app/audit-claude-usage.ts",
    "diagnose:claude-usage": "bun src/usage-diagnostics/run.ts",
    "reprice": "bun src/app/reprice-history.ts",
    "check:packages": "eslint package.json",
    "check": "bunx --bun tsc --noEmit",
    "test": "bun test",
    "test:visual": "bun test tests/visual",
    "test:visual:update": "UPDATE_VISUAL_BASELINES=1 bun test tests/visual",
    "build": "bunx --bun vite build",
    "verify": "bun run check:packages && bun run check && bun test && bun run build"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "echarts": "6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@csstools/color-helpers": "6.1.1",
    "@csstools/css-color-parser": "4.2.0",
    "@csstools/css-parser-algorithms": "4.0.0",
    "@csstools/css-tokenizer": "4.0.0",
    "@happy-dom/global-registrator": "20.11.2",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-package-json": "1.7.1",
    "happy-dom": "20.11.2",
    "jsonc-eslint-parser": "3.3.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
